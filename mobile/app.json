{
  "expo": {
    "name": "Calculadora de cocho",
    "slug": "roboflow-cocho-capture-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Precisamos da câmera para gravar o vídeo do cocho.",
        "NSMicrophoneUsageDescription": "Precisamos do microfone para gravar o vídeo do cocho.",
        "NSPhotoLibraryUsageDescription": "Precisamos acessar a galeria para selecionar um vídeo do cocho e registrar o horário real de gravação.",
        "UIBackgroundModes": ["fetch"]
      }
    },
    "android": {
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.lucascostaufrrj.roboflowcochocaptureapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101820"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Precisamos da câmera para gravar o vídeo do cocho.",
          "microphonePermission": "Precisamos do microfone para gravar o vídeo do cocho."
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101820",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": false,
          "granularPermissions": ["video"]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3D8BFD"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8740f4d0-7c76-4a92-98b7-c4a5429abe9e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8740f4d0-7c76-4a92-98b7-c4a5429abe9e"
    }
  }
}
