# URL base do NOSSO backend (nunca a URL do Roboflow diretamente).
EXPO_PUBLIC_API_BASE_URL=https://seu-backend.exemplo.com

# Chave de autenticação do app NO NOSSO backend.
# Esta chave NÃO É a ROBOFLOW_API_KEY — o app nunca conhece a chave do Roboflow.
EXPO_PUBLIC_BACKEND_API_KEY=coloque_uma_chave_de_app_aqui
