# Copie este arquivo para `.env` e preencha os valores reais.
# NUNCA faça commit do arquivo `.env` com segredos reais.

# --- Aplicação ---
APP_ENV=development
LOG_LEVEL=INFO

# Versão nativa mais recente do app móvel (campo "version" do app.json).
# Atualize sempre que gerar uma build nova com `eas build` — é assim que o
# app avisa quem ainda está numa build mais antiga (não afeta atualização
# OTA via `eas update`, que já chega sozinha independente disso).
ULTIMA_VERSAO_NATIVA=1.0.0

# --- Autenticação do app móvel neste backend (NÃO é a chave do Roboflow) ---
BACKEND_API_KEY=troque-por-uma-chave-forte-gerada-por-voce

# Chave exigida, além da de cima, para cadastrar/editar/excluir um cocho.
# Só quem administra a lista de cochos deve ter essa chave configurada no
# aparelho (tela Sobre do app) — o resto da equipe usa só BACKEND_API_KEY e
# enxerga a tela de Cochos como somente leitura.
ADMIN_API_KEY=troque-por-outra-chave-forte-diferente-da-de-cima

# --- Rate limiting ---
RATE_LIMIT_CAPTURES=10/minute

# --- Upload / vídeo ---
MAX_VIDEO_SIZE_MB=150
# Vídeo selecionado da galeria (intervalo livre, como sempre foi).
MIN_VIDEO_DURATION_S=7
MAX_VIDEO_DURATION_S=10
# Vídeo gravado na hora pela câmera do app (duração fixa por construção).
# TEM que bater com RECORDING_DURATION_S/RECORDING_TOLERANCE_S em
# mobile/src/utils/video.ts.
RECORDING_DURATION_S=8.5
RECORDING_DURATION_TOLERANCE_S=0.3

# --- Peso ---
MIN_PESO_KG=0.01
MAX_PESO_KG=2000

# --- Extração de frames ---
FRAMES_PER_SECOND=3
FOCUS_SCORE_THRESHOLD=100

# --- ffmpeg (normalização/reencode de vídeo) ---
# O ffmpeg roda como subprocesso do MESMO container, então a memória dele
# conta no teto do plano (512MB no Render) — foi o que derrubou o serviço em
# 22/09. Estes valores mantêm o pico previsível; ver os comentários em
# `app/config.py` antes de mexer.
FFMPEG_THREADS=1
FFMPEG_MAX_CONCORRENTES=1
NORMALIZACAO_MAX_WIDTH=1280
NORMALIZACAO_MAX_HEIGHT=720

# --- Armazenamento temporário (vídeo em processamento; efêmero de propósito) ---
# local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./tmp_storage

# Preencha somente se STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Armazenamento DURÁVEL (registro de cochos, idempotência) ---
# Local: não precisa mexer, o disco da própria máquina já é durável.
# Render: isto TEM que apontar pro mount path de um Persistent Disk anexado
# ao serviço (Render -> serviço -> Disks -> Add Disk), senão todo deploy
# reseta o registro de cochos para vazio. Ver comentário em
# config.Settings.PERSISTENT_DATA_PATH.
PERSISTENT_DATA_PATH=./persistent_data

# --- Backend do registro de cochos ---
# file: usa PERSISTENT_DATA_PATH acima (só durável com Persistent Disk pago
# no Render). github: grava o registro como um JSON dentro do próprio
# repositório git via API do GitHub — gratuito, nunca expira/pausa. Ver
# comentário em config.Settings.COCHO_REGISTRY_BACKEND.
COCHO_REGISTRY_BACKEND=file

# Preencha só se COCHO_REGISTRY_BACKEND=github.
# Personal Access Token fine-grained do GitHub, com permissão "Contents:
# Read and write" restrita a este repositório (Settings do GitHub > Developer
# settings > Fine-grained tokens > Generate new token).
GITHUB_TOKEN=
# Formato "usuario/repositorio".
GITHUB_REPO=
GITHUB_COCHOS_PATH=backend/_data/cochos.json
GITHUB_BRANCH=main

# --- Backend do registro de tipos de alimento ---
# Mesma lógica de COCHO_REGISTRY_BACKEND acima, registro separado. Quando
# "github", reaproveita GITHUB_TOKEN/GITHUB_REPO/GITHUB_BRANCH acima.
TIPO_ALIMENTO_REGISTRY_BACKEND=file
GITHUB_TIPOS_ALIMENTO_PATH=backend/_data/tipos_alimento.json

# --- Densidade aparente do tipo de alimento (Kg/L) ---
MIN_DENSIDADE_APARENTE_KG_L=0.05
MAX_DENSIDADE_APARENTE_KG_L=3.0

# --- Roboflow ---
# Workspace e projeto NÃO são segredos; a chave privada SIM.
ROBOFLOW_WORKSPACE=lucas-da-guia-costa
ROBOFLOW_PROJECT=peso-de-alimento-no-cocho
ROBOFLOW_UPLOAD_BASE_URL=https://api.roboflow.com
ROBOFLOW_UPLOAD_TIMEOUT_S=30
ROBOFLOW_UPLOAD_MAX_RETRIES=4

# Chave privada do Roboflow — mantenha exclusivamente no backend/servidor.
# Placeholder: NÃO é uma chave real.
ROBOFLOW_API_KEY=coloque_sua_chave_privada_aqui_apenas_no_servidor

# --- Validador de cocho ---
# mock | roboflow
TROUGH_VALIDATOR=mock
TROUGH_VALIDATOR_MOCK_ALWAYS_VALID=true
TROUGH_VALIDATOR_MOCK_CONFIDENCE=0.95
# API de inferência hospedada do Roboflow (diferente de ROBOFLOW_UPLOAD_BASE_URL,
# que é a API de dataset).
ROBOFLOW_INFERENCE_BASE_URL=https://detect.roboflow.com
# Formato "projeto/versao", ex: reconhecimento-de-cocho/13
ROBOFLOW_TROUGH_MODEL_ID=
# Chave do workspace onde o modelo de detecção (reconhecimento-de-cocho) vive.
# Deixe vazia SOMENTE se esse projeto estiver na mesma conta/workspace de
# ROBOFLOW_API_KEY acima — caso contrário essa chave é obrigatória.
ROBOFLOW_TROUGH_API_KEY=
ROBOFLOW_TROUGH_CONFIDENCE_THRESHOLD=0.5

# --- Modelo 1: reenvio de frames "cocho incompleto" como dado bruto ---
# Desligado por padrão — só ligar depois de confirmar que ROBOFLOW_TROUGH_API_KEY
# (acima) tem permissão de ESCRITA no projeto abaixo (não só leitura/inferência).
ENVIAR_COCHO_INCOMPLETO_MODELO_1=false
ROBOFLOW_TROUGH_UPLOAD_PROJECT=reconhecimento-de-cocho
# Fração dos frames incompletos de cada captura enviada ao Modelo 1 (0 a 1).
# 0.5 = metade, distribuída uniformemente ao longo do vídeo.
ROBOFLOW_TROUGH_FRACAO_FRAMES_INCOMPLETOS=0.5
