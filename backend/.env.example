# Copie este arquivo para `.env` e preencha os valores reais.
# NUNCA faça commit do arquivo `.env` com segredos reais.

# --- Aplicação ---
APP_ENV=development
LOG_LEVEL=INFO

# Versão nativa mais recente do app móvel (campo "version" do app.json).
# Atualize sempre que gerar uma build nova com `eas build` — é assim que o
# app avisa quem ainda está numa build mais antiga (não afeta atualização
# OTA via `eas update`, que já chega sozinha independente disso).
ULTIMA_VERSAO_NATIVA=1.0.0

# --- Autenticação do app móvel neste backend (NÃO é a chave do Roboflow) ---
BACKEND_API_KEY=troque-por-uma-chave-forte-gerada-por-voce

# Chave exigida, além da de cima, para cadastrar/editar/excluir um cocho.
# Só quem administra a lista de cochos deve ter essa chave configurada no
# aparelho (tela Sobre do app) — o resto da equipe usa só BACKEND_API_KEY e
# enxerga a tela de Cochos como somente leitura.
ADMIN_API_KEY=troque-por-outra-chave-forte-diferente-da-de-cima

# --- Rate limiting ---
RATE_LIMIT_CAPTURES=10/minute

# --- Upload / vídeo ---
MAX_VIDEO_SIZE_MB=150
# Vídeo selecionado da galeria (intervalo livre, como sempre foi).
MIN_VIDEO_DURATION_S=7
MAX_VIDEO_DURATION_S=10
# Vídeo gravado na hora pela câmera do app (duração fixa por construção).
# TEM que bater com RECORDING_DURATION_S/RECORDING_TOLERANCE_S em
# mobile/src/utils/video.ts.
RECORDING_DURATION_S=8.5
RECORDING_DURATION_TOLERANCE_S=0.3

# --- Peso ---
MIN_PESO_KG=0.01
MAX_PESO_KG=2000

# --- Extração de frames ---
FRAMES_PER_SECOND=3
FOCUS_SCORE_THRESHOLD=100

# --- Armazenamento temporário ---
# local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./tmp_storage

# Preencha somente se STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Roboflow ---
# Workspace e projeto NÃO são segredos; a chave privada SIM.
ROBOFLOW_WORKSPACE=lucas-da-guia-costa
ROBOFLOW_PROJECT=peso-de-alimento-no-cocho
ROBOFLOW_PROJECT_ID=Nl9vkgG54JP6KWBK4ala
ROBOFLOW_UPLOAD_BASE_URL=https://api.roboflow.com
ROBOFLOW_UPLOAD_TIMEOUT_S=30
ROBOFLOW_UPLOAD_MAX_RETRIES=4

# Chave privada do Roboflow — mantenha exclusivamente no backend/servidor.
# Placeholder: NÃO é uma chave real.
ROBOFLOW_API_KEY=coloque_sua_chave_privada_aqui_apenas_no_servidor

# --- Validador de cocho ---
# mock | roboflow
TROUGH_VALIDATOR=mock
TROUGH_VALIDATOR_MOCK_ALWAYS_VALID=true
TROUGH_VALIDATOR_MOCK_CONFIDENCE=0.95
# API de inferência hospedada do Roboflow (diferente de ROBOFLOW_UPLOAD_BASE_URL,
# que é a API de dataset).
ROBOFLOW_INFERENCE_BASE_URL=https://detect.roboflow.com
# Formato "projeto/versao", ex: reconhecimento-de-cocho/13
ROBOFLOW_TROUGH_MODEL_ID=
# Chave do workspace onde o modelo de detecção (reconhecimento-de-cocho) vive.
# Deixe vazia SOMENTE se esse projeto estiver na mesma conta/workspace de
# ROBOFLOW_API_KEY acima — caso contrário essa chave é obrigatória.
ROBOFLOW_TROUGH_API_KEY=
ROBOFLOW_TROUGH_CONFIDENCE_THRESHOLD=0.5
